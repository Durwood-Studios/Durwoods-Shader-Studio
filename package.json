{
	"name": "shader-studio",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:next": "eslint . --max-warnings=0",
		"lint:fix": "biome check --write . && eslint . --fix",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write . && prettier --write \"**/*.{md,json,yml,yaml,css}\"",
		"format:check": "biome format . && prettier --check \"**/*.{md,json,yml,yaml,css}\"",
		"check": "npm run lint && npm run lint:next && npm run format:check && npm run typecheck",
		"gen:manifests": "tsx scripts/generate-manifests.ts",
		"size": "size-limit",
		"ver:large": "tsx scripts/bump-version.ts --large",
		"ver:small": "tsx scripts/bump-version.ts --small",
		"prepare": "husky"
	},
	"dependencies": {
		"@monaco-editor/react": "4.7.0",
		"lucide-react": "0.468.0",
		"next": "^15.5.15",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"zod": "3.24.1",
		"zustand": "5.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/eslintrc": "^3.3.5",
		"@size-limit/preset-small-lib": "^11.2.0",
		"@tailwindcss/postcss": "^4.1.0",
		"@types/node": "22.10.7",
		"@types/react": "19.0.7",
		"@types/react-dom": "19.0.3",
		"eslint": "^9.39.4",
		"eslint-config-next": "^15.5.15",
		"husky": "9.1.7",
		"lint-staged": "^15.5.2",
		"postcss": "8.4.49",
		"prettier": "3.4.2",
		"size-limit": "11.1.6",
		"tailwindcss": "^4.1.0",
		"tsx": "^4.21.0",
		"typescript": "5.7.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [],
		"overrides": {
			"dompurify": ">=3.2.4"
		}
	},
	"overrides": {
		"dompurify": ">=3.2.4"
	}
}
